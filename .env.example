# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose.yml and the application)
WIKI_DB_NAME=wiki
WIKI_DB_USERNAME=wiki
WIKI_DB_PASSWORD=change-me

# Spring profiles: "local" for development without HTTPS, "entra" for company login
SPRING_PROFILES_ACTIVE=local

# Uploaded files: directory outside the static files (Compose mounts a volume there) and size limits.
# PNG/JPEG/PDF at most 10 MB per file (spec U-01); MP4/WebM video has its own, larger limit.
WIKI_ATTACHMENTS_DIR=./data/attachments
WIKI_UPLOAD_MAX_FILE_SIZE=10MB
WIKI_UPLOAD_MAX_VIDEO_SIZE=100MB

# First admin on a fresh (non-local) installation; used once while the user table is empty.
# Give a password for form login and/or the Entra e-mail address for company login.
WIKI_BOOTSTRAP_ADMIN_USERNAME=
WIKI_BOOTSTRAP_ADMIN_PASSWORD=
WIKI_BOOTSTRAP_ADMIN_EMAIL=

# Microsoft Entra ID app registration (provided by the company supervisor)
WIKI_ENTRA_TENANT_ID=
WIKI_ENTRA_CLIENT_ID=
WIKI_ENTRA_CLIENT_SECRET=

# Public URL of the wiki, used for the links in e-mail (never taken from request headers)
WIKI_BASE_URL=http://localhost:8080

# Mail for "wachtwoord vergeten" and user invitations. Leave both ways below empty during development: the
# reset link or invitation link is then written to the application log instead of mailed. With profile
# local the application reads this file itself (spring.config.import), so mvnw and IntelliJ use the same
# values as Docker Compose. Whichever way sends, invitations can go to any address. A refused mail shows
# up as a red message on /admin/users, with the reason given by the server.
#
# 1. Microsoft Graph (LogicAI, Microsoft 365; no mailbox password). The wiki sends as the Entra app
#    registration above (WIKI_ENTRA_*) from the mailbox below, through the Graph API. The tenant admin
#    grants the application permission Mail.Send (with admin consent) and limits the app to this one
#    mailbox with an Exchange application access policy; see README. Keeps working after Microsoft
#    switches off password login on SMTP (end of December 2026, message MC786329). Goes before SMTP.
WIKI_MAIL_GRAPH_SENDER=
#
# 2. SMTP with a password.
# Gmail:          WIKI_MAIL_HOST=smtp.gmail.com, port 587, STARTTLS on; USERNAME and FROM are the Gmail
#                 address, PASSWORD an app password (2-step verification -> App passwords).
# Microsoft 365:  only until December 2026 and not recommended: WIKI_MAIL_HOST=smtp.office365.com, port 587,
#                 STARTTLS on; USERNAME and FROM are the mailbox, PASSWORD its password (an app password
#                 when MFA is on), and the mailbox needs "Authenticated SMTP" in the Microsoft 365 admin
#                 center (Mail -> Manage email apps). "535 5.7.3 Authentication unsuccessful" means wrong
#                 or empty credentials, "535 5.7.139 ... SmtpClientAuthentication is disabled" that
#                 Authenticated SMTP is off. Prefer way 1.
WIKI_MAIL_HOST=
WIKI_MAIL_PORT=587
WIKI_MAIL_STARTTLS=true
WIKI_MAIL_USERNAME=
WIKI_MAIL_PASSWORD=
WIKI_MAIL_FROM=wiki@logicai.nl
